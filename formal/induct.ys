# Unbounded proof of our own properties by k-induction (closes at k=1).
read_verilog -formal -sv -DFORMAL -DSYNTHESIS rtl/axi4l_regs_core.sv formal/axi4l_formal.sv
prep -top formal_axi4l
flatten
memory_map
opt -fast
async2sync
dffunmap
sat -tempinduct -maxsteps 12 -prove-asserts -set-init-zero -verify
